FROM python:3.12-slim
WORKDIR /app
COPY --from=ghcr.io/astral-sh/uv:0.12.5 /uv /bin/uv
COPY pyproject.toml uv.lock ./
# Locked runtime dependencies only, installed into the system interpreter of the image.
RUN uv export --frozen --no-dev --no-hashes -o /tmp/requirements.txt && uv pip install --system --no-cache -r /tmp/requirements.txt
COPY backend backend
COPY data data
RUN mkdir var && useradd --create-home demo && chown -R demo:demo /app
USER demo
# Render sets PORT; Compose keeps 8000.
CMD ["sh", "-c", "exec uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
