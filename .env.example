# demo = scripted simulation; openrouter = actual read-only model tool calling
AGENT_MODE=demo
OPENROUTER_API_KEY=
# Choose a current OpenRouter model ID with tool calling support.
# Example only, not a promised availability or pricing recommendation:
OPENROUTER_MODEL=z-ai/glm-5.3
REFERENCE_DATE=2026-10-12
DEMO_PASSWORD=local-demo
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# The server runs the morning briefing by itself once per demo date (max 5 analyses). In openrouter mode this is billed.
BRIEFING_AUTO=true
# DB_PATH is optional; default is var/crm.sqlite3 under the project root.
